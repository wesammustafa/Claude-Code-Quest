{
  "permissions": {
    "deny": [
      "Read(./**/private/**)",
      "Edit(./sources/**)",
      "Edit(./**/booking-*)",
      "Edit(./**/venue-email-*)",
      "mcp__bookings__cancel_booking"
    ],
    "ask": [
      "Bash"
    ],
    "allow": [
      "mcp__bookings__get_booking",
      "mcp__bookings__list_bookings"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-private-numbers.sh",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
